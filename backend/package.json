{
  "name": "rootbridge-backend",
  "version": "3.0.0",
  "description": "RootBridge Sprint 3 API: Express MVC + MongoDB (Mongoose), bcrypt, JWT",
  "main": "server.js",
  "type": "commonjs",
 "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:ci": "REQUIRE_DB=1 node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "nodemonConfig": {
    "ignore": [
      "uploads/*",
      "tests/*"
    ]
  }
}
