# Copy this file to ".env" and fill it in. Never commit .env to Git.

PORT=5000
NODE_ENV=development

# The website address(es) allowed to call this API, comma-separated.
# Local development: the Vite dev server. On Render: your Render address.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB. Local:
MONGODB_URI=mongodb://127.0.0.1:27017/rootbridge
# MongoDB Atlas looks like this (note the database name before the "?"):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/rootbridge?retryWrites=true&w=majority

# A long random string. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Optional: require a code to sign up as a Teacher (leave empty to allow anyone)
TEACHER_SIGNUP_CODE=

# Optional: lets you read contact-form messages at
# GET /api/contact/messages with the header  x-support-token: <this value>
SUPPORT_TOKEN=

# Optional: Google Gemini key for strict pronunciation grading.
# Free key: https://aistudio.google.com/apikey
# Without it, a strict local check is used instead (the lesson never breaks).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# How long to wait for the AI before using the local check (milliseconds)
GEMINI_TIMEOUT_MS=4000
